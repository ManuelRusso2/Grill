<%-- Definizione del tipo di contenuto e della codifica dei caratteri (UTF-8) --%>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>

<%-- Inclusione della libreria di tag JSTL Core per la gestione della logica condizionale e delle variabili --%>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>

<!DOCTYPE html>
<html lang="it">
<head>
    <%-- Metadati di base della pagina per codifica e ottimizzazione dispositivi mobili --%>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <%-- Titolo della scheda del browser --%>
    <title>Grill - E-Commerce</title>

    <%-- Fogli di stile base dell'applicazione --%>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/global.css">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
    
    <%-- Foglio di stile per layout responsive e regole di stampa @media print (deve rimanere per ultimo) --%>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/responsive.css">

    <%-- Script JavaScript eseguiti in modo differito (defer) per il badge carrello e la ricerca AJAX --%>
    <script src="${pageContext.request.contextPath}/js/cart-badge.js" defer></script>
    <script src="${pageContext.request.contextPath}/js/search.js" defer></script>
</head>
<body>

<%-- Intestazione principale del sito contenente il logo, la ricerca e la barra di navigazione --%>
<header class="site-header">
    <div class="container navbar">
        <%-- Logo dell'e-commerce con collegamento diretto alla Home Page --%>
        <a class="brand" href="${pageContext.request.contextPath}/index.jsp">Grill</a>

        <%-- Estrazione del percorso della pagina/servlet corrente per controllare la visibilità della ricerca --%>
        <c:set var="currentPath" value="${pageContext.request.servletPath}" />

        <%-- La barra di ricerca viene nascosta automaticamente nelle pagine di Login e Registrazione --%>
        <c:if test="${currentPath != '/jsp/common/login.jsp' and currentPath != '/jsp/user/registrazione.jsp'}">
            <div class="search-wrapper">
                <input type="text" id="searchInput" class="search-input" placeholder="Cerca prodotti..." autocomplete="off"
                       data-context-path="${pageContext.request.contextPath}">
                <%-- Contenitore per i suggerimenti di ricerca dinamici popolati via JavaScript --%>
                <div id="searchSuggestions" class="search-suggestions" style="display:none;"></div>
            </div>
        </c:if>

        <%-- Sezione contenente i collegamenti principali del menu di navigazione --%>
        <nav class="nav-links">