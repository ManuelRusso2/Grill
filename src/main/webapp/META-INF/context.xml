<?xml version="1.0" encoding="UTF-8"?>
<!-- Definizione del contesto dell'applicazione web per Apache Tomcat -->
<Context>

    <!-- 
        ========================================================================
        Configurazione della risorsa JNDI per il Connection Pool JDBC al DB.
        Consente all'app Java di accedere al DB MySQL in modo efficiente.
        ========================================================================
        Spiegazione dei parametri:
        - name: Nome JNDI univoco usato dall'app (es. java:comp/env/jdbc/grillDB)
        - auth: Gestione delle connessioni affidata a Tomcat (Container)
        - type: Interfaccia Java per la gestione del pool di connessioni
        - driverClassName: Driver ufficiale per MySQL 8+
        - url: Stringa di connessione (DB 'grill' su localhost). 
               Include SSL disabilitato e Timezone su UTC per evitare errori.
        - username / password: Credenziali del database
        - maxTotal: Massimo di connessioni attive contemporaneamente (20)
        - maxIdle: Massimo di connessioni inattive tenute aperte pronte all'uso (10)
        - maxWaitMillis: Tempo massimo (10 sec) di attesa se il pool è pieno
        ========================================================================
    -->
    <Resource name="jdbc/grillDB"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/grill?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=UTC"
              username="root" 
              password="root"
              maxTotal="20"
              maxIdle="10"
              maxWaitMillis="10000" />

</Context>